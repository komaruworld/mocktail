diff --git a/bionic/linker/linker_soinfo.cpp b/bionic/linker/linker_soinfo.cpp
index cb70ca162..4d0dfa0b4 100644
--- a/bionic/linker/linker_soinfo.cpp
+++ b/bionic/linker/linker_soinfo.cpp
@@ -32,0 +33 @@
+#include <stdint.h>
@@ -47,0 +49,6 @@
+extern "C" void mocktail_before_soinfo_constructors(const char* realpath,
+                                                    uintptr_t base)
+    __attribute__((weak));
+extern "C" bool mocktail_should_skip_soinfo_constructors(const char* realpath)
+    __attribute__((weak));
+
@@ -225,5 +225,25 @@ const ElfW(Sym)* soinfo_do_lookup(const char* name, const version_info* vi,
 soinfo::soinfo(android_namespace_t* ns, const char* realpath,
                const struct stat* file_stat, off64_t file_offset,
                int rtld_flags) {
+  // Android's libc++ accepts zero-filled empty containers, but host
+  // libstdc++ keeps non-null self-pointers in objects such as std::string.
+  // End those initially constructed member lifetimes before the inherited
+  // raw clear, then reconstruct every non-trivial member afterwards.
+  std::destroy_at(&symbols);
+  std::destroy_at(&tlsdesc_args_);
+  std::destroy_at(&tls_);
+  std::destroy_at(&secondary_namespaces_);
+  std::destroy_at(&dt_runpath_);
+  std::destroy_at(&realpath_);
+  std::destroy_at(&parents_);
+  std::destroy_at(&children_);
   memset(this, 0, sizeof(*this));
+
+  new (&children_) decltype(children_)();
+  new (&parents_) decltype(parents_)();
+  new (&realpath_) decltype(realpath_)();
+  new (&dt_runpath_) decltype(dt_runpath_)();
+  new (&secondary_namespaces_) decltype(secondary_namespaces_)();
+  new (&tls_) decltype(tls_)();
+  new (&tlsdesc_args_) decltype(tlsdesc_args_)();
   new (&symbols) decltype(symbols)();
@@ -531,0 +539,15 @@ static void call_array(const char* array_name __unused,
+    const char* ctor_trace = getenv("MOCKTAIL_CTOR_TRACE");
+    if (ctor_trace != nullptr && ctor_trace[0] != '\0' &&
+        strcmp(ctor_trace, "0") != 0) {
+      Dl_info info{};
+      uintptr_t offset = 0;
+      if (dladdr(reinterpret_cast<void*>(functions[i]), &info) != 0 &&
+          info.dli_fbase != nullptr) {
+        offset = reinterpret_cast<uintptr_t>(functions[i]) -
+                 reinterpret_cast<uintptr_t>(info.dli_fbase);
+      }
+      async_safe_format_log(ANDROID_LOG_INFO, "mocktail",
+                            "%s[%d] %s function=%p offset=0x%zx",
+                            array_name, i, realpath ? realpath : "(null)",
+                            reinterpret_cast<void*>(functions[i]), offset);
+    }
@@ -584,0 +607,8 @@ void soinfo::call_constructors() {
+  if (mocktail_before_soinfo_constructors != nullptr) {
+    mocktail_before_soinfo_constructors(get_realpath(), load_bias);
+  }
+  if (mocktail_should_skip_soinfo_constructors != nullptr &&
+      mocktail_should_skip_soinfo_constructors(get_realpath())) {
+    PRINT("\"%s\": skipping constructors by Mocktail hook", get_realpath());
+    return;
+  }
